# Every environment variable the app reads, with a safe example or an empty value.
# Set them in your shell or your IDE's run configuration; without them the defaults in application.yml apply.
# A .env copy works only with tools that load it (Docker Compose, from Class 8). Never commit real values.
DATABASE_URL=jdbc:mysql://localhost:3306/fooddash
DATABASE_USER=fooddash
DATABASE_PASSWORD=
# fake (default, no network) or wallet (needs the two variables below)
PAYMENT_PROVIDER=fake
WALLET_BASE_URL=
WALLET_API_KEY=
